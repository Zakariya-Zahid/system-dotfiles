# Generated by hand for the systems-dotfiles repo.
# Powerlevel10k "lean" style - clean, minimal, developer-focused.
#
# Source this from .zshrc AFTER the powerlevel10k theme:
#   source ~/.p10k.zsh
#
# Re-tune interactively any time with: `p10k configure`

# Lean prompt layout:
#   <- left: prompt_char dir vcs
#   -> right: status command_execution_time context pyenv goenv nodeenv time
#   blank line above, transient prompt below

# ------------------------------------------------------------------ global
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
POWERLEVEL9K_DISABLE_HOT_RELOAD=true
POWERLEVEL9K_MODE=nerdfont-v3
POWERLEVEL9K_ICON_PADDING=none
POWERLEVEL9K_ICON_CONTENT_EXPANSION='${P9K_CONTENT}'
POWERLEVEL9K_PROMPT_ADD_NEWLINE=true
POWERLEVEL9K_PROMPT_CHAR_NEWLINE=true

# ------------------------------------------------------------------ left
POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(
  prompt_char
  dir
  vcs
)

# ------------------------------------------------------------------ right
POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(
  status
  command_execution_time
  context
  pyenv
  goenv
  nodeenv
  kubecontext
  time
)

# ------------------------------------------------------------ prompt_char
POWERLEVEL9K_PROMPT_CHAR_BACKGROUND=
POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_CONTENT_EXPANSION='❯'
POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_FOREGROUND='#7aa2f7'
POWERLEVEL9K_PROMPT_CHAR_ERROR_VIINS_CONTENT_EXPANSION='❯'
POWERLEVEL9K_PROMPT_CHAR_ERROR_VIINS_FOREGROUND='#f7768e'
POWERLEVEL9K_PROMPT_CHAR_OK_VIOLINE_CONTENT_EXPANSION='❯'
POWERLEVEL9K_PROMPT_CHAR_OK_VIOLINE_FOREGROUND='#7aa2f7'
POWERLEVEL9K_PROMPT_CHAR_ERROR_VIOLINE_CONTENT_EXPANSION='❯'
POWERLEVEL9K_PROMPT_CHAR_ERROR_VIOLINE_FOREGROUND='#f7768e'
POWERLEVEL9K_PROMPT_CHAR_LEFT_PROMPT_LAST_SEGMENT_END_SYMBOL=' '
POWERLEVEL9K_PROMPT_CHAR_LEFT_PROMPT_FIRST_SEGMENT_START_SYMBOL=

# ------------------------------------------------------------------ dir
POWERLEVEL9K_DIR_BACKGROUND=
POWERLEVEL9K_DIR_FOREGROUND='#a9b1d6'
POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='#a9b1d6'
POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='#7dcfff'
POWERLEVEL9K_DIR_SHORTEN_DELIMITER=.
POWERLEVEL9K_DIR_SHORTEN_STRATEGY=truncate_to_unique
POWERLEVEL9K_DIR_MAX_LENGTH=40
POWERLEVEL9K_DIR_SHOW_WRITABLE=v3
POWERLEVEL9K_HOME_FOLDER_ABBREVIATION=~
POWERLEVEL9K_DIR_PATH_HIGHLIGHT_FOREGROUND='#7dcfff'
POWERLEVEL9K_DIR_PATH_HIGHLIGHT_BOLD=true

# ------------------------------------------------------------------ vcs
POWERLEVEL9K_VCS_BACKGROUND=
POWERLEVEL9K_VCS_CLEAN_FOREGROUND='#9ece6a'
POWERLEVEL9K_VCS_MODIFIED_FOREGROUND='#e0af68'
POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND='#e0af68'
POWERLEVEL9K_VCS_CONFLICTED_FOREGROUND='#f7768e'
POWERLEVEL9K_VCS_LOADING_FOREGROUND='#a9b1d6'
POWERLEVEL9K_VCS_BRANCH_ICON='\uF126 '
POWERLEVEL9K_VCS_GIT_ICON=''
POWERLEVEL9K_VCS_GIT_REMOTE_ICON=''
POWERLEVEL9K_VCS_MAX_NUM_CACHED_ENTRIES=1000
POWERLEVEL9K_VCS_MAX_INDEX_SIZE_DIRTY=1000
POWERLEVEL9K_VCS_CONTENT_EXPANSION='${P9K_CONTENT}'
POWERLEVEL9K_VCS_LOADING_TEXT='loading'
POWERLEVEL9K_VCS_ACTIONFORMAT_FOREGROUND='#f7768e'

# ---------------------------------------------------------------- status
POWERLEVEL9K_STATUS_BACKGROUND=
POWERLEVEL9K_STATUS_OK=true
POWERLEVEL9K_STATUS_OK_FOREGROUND='#9ece6a'
POWERLEVEL9K_STATUS_OK_PIPE_FOREGROUND='#9ece6a'
POWERLEVEL9K_STATUS_ERROR_FOREGROUND='#f7768e'
POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND='#f7768e'
POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND='#f7768e'
POWERLEVEL9K_STATUS_EXTENDED_STATES=true
POWERLEVEL9K_STATUS_OK_VISUAL_IDENTIFIER_EXPANSION='✔'
POWERLEVEL9K_STATUS_ERROR_VISUAL_IDENTIFIER_EXPANSION='✘'

# ---------------------------------------------------- command_execution_time
POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND=
POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='#565f89'
POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=2
POWERLEVEL9K_COMMAND_EXECUTION_TIME_PRECISION=1
POWERLEVEL9K_COMMAND_EXECUTION_TIME_FORMAT='d h m s'

# --------------------------------------------------------------- context
POWERLEVEL9K_CONTEXT_BACKGROUND=
POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND='#f7768e'
POWERLEVEL9K_CONTEXT_FOREGROUND='#9aa5ce'
POWERLEVEL9K_CONTEXT_ROOT_TEMPLATE='%n@%m'
POWERLEVEL9K_CONTEXT_TEMPLATE='%n@%m'
POWERLEVEL9K_ALWAYS_SHOW_CONTEXT=false

# --------------------------------------------------------------- pyenv
POWERLEVEL9K_PYENV_BACKGROUND=
POWERLEVEL9K_PYENV_FOREGROUND='#e0af68'
POWERLEVEL9K_PYENV_PROMPT_ALWAYS_SHOW=false

# --------------------------------------------------------------- goenv
POWERLEVEL9K_GOENV_BACKGROUND=
POWERLEVEL9K_GOENV_FOREGROUND='#7aa2f7'
POWERLEVEL9K_GOENV_PROMPT_ALWAYS_SHOW=false

# ------------------------------------------------------------- nodeenv
POWERLEVEL9K_NODENV_BACKGROUND=
POWERLEVEL9K_NODENV_FOREGROUND='#9ece6a'
POWERLEVEL9K_NODENV_PROMPT_ALWAYS_SHOW=false

# ----------------------------------------------------------- kubecontext
POWERLEVEL9K_KUBECONTEXT_BACKGROUND=
POWERLEVEL9K_KUBECONTEXT_FOREGROUND='#bb9af7'
POWERLEVEL9K_KUBECONTEXT_SHORTEN=true
POWERLEVEL9K_KUBECONTEXT_DEFAULT_CONTEXT_FOREGROUND='#bb9af7'
POWERLEVEL9K_KUBECONTEXT_SHOW_COMMAND=false

# ---------------------------------------------------------------- time
POWERLEVEL9K_TIME_BACKGROUND=
POWERLEVEL9K_TIME_FOREGROUND='#565f89'
POWERLEVEL9K_TIME_FORMAT='%D{%I:%M %p}'
POWERLEVEL9K_TIME_UPDATE_ON_COMMAND=false
POWERLEVEL9K_TIME_VISUAL_IDENTIFIER_EXPANSION=

# ------------------------------------------------------- transient prompt
POWERLEVEL9K_TRANSIENT_PROMPT=always
POWERLEVEL9K_PROMPT_CHAR_TRANSIENT_BACKGROUND=

# -------------------------------------------------------- instant prompt
POWERLEVEL9K_INSTANT_PROMPT=verbose

# ----------------------------------------------------------- misc colors
POWERLEVEL9K_BG=
POWERLEVEL9K_FG='#a9b1d6'
POWERLEVEL9K_LEFT_PROMPT_LAST_SEGMENT_END_SYMBOL=' '
POWERLEVEL9K_LEFT_PROMPT_FIRST_SEGMENT_START_SYMBOL=
POWERLEVEL9K_RIGHT_PROMPT_FIRST_SEGMENT_START_SYMBOL=
POWERLEVEL9K_EMPTY_LINE_RIGHT_PROMPT_FIRST_SEGMENT_START_SYMBOL=
POWERLEVEL9K_MULTILINE_FIRST_PROMPT_PREFIX=
POWERLEVEL9K_MULTILINE_NEWLINE_PROMPT_PREFIX=
POWERLEVEL9K_MULTILINE_LAST_PROMPT_PREFIX=
POWERLEVEL9K_MULTILINE_FIRST_PROMPT_SUFFIX=
POWERLEVEL9K_MULTILINE_NEWLINE_PROMPT_SUFFIX=
POWERLEVEL9K_MULTILINE_LAST_PROMPT_SUFFIX=
